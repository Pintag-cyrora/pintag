.env
.env.*

# Playwright suites under tests/ (per-suite .gitignore files also exist for
# some; this is the one rule that covers all of them)
tests/*/node_modules/
tests/*/playwright-report/
tests/*/test-results/

# Python bytecode (scripts/*.py are imported by tests)
__pycache__/

# Diagnostic result files (scripts/diagnostics/orphan-originals/run.sh writes these next to itself)
scripts/diagnostics/orphan-originals/preflight.txt
scripts/diagnostics/orphan-originals/diagnostic.txt
