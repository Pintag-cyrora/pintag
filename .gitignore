.env
.env.*

# Playwright suites under tests/ (per-suite .gitignore files also exist for
# some; this is the one rule that covers all of them)
tests/*/node_modules/
tests/*/playwright-report/
tests/*/test-results/

# Python bytecode (scripts/*.py are imported by tests)
__pycache__/

# Diagnostic result files (scripts/diagnostics/orphan-originals/run.sh writes these next to itself)
scripts/diagnostics/orphan-originals/preflight.txt
scripts/diagnostics/orphan-originals/diagnostic.txt
scripts/diagnostics/orphan-originals/reconcile.csv
scripts/diagnostics/orphan-originals/source-health.csv
scripts/diagnostics/orphan-originals/reconcile-objects.csv
scripts/diagnostics/orphan-originals/reconcile-summary.md
# a downloaded reconciliation artifact holds real object names and ids: never commit it, wherever it is saved
reconcile-objects.csv
reconcile-summary.md
orphan-artifact/
scripts/diagnostics/orphan-originals/updated-at-probe.txt
scripts/diagnostics/orphan-originals/gallery-state.csv
scripts/diagnostics/orphan-originals/gallery-listing-detail.csv
scripts/diagnostics/orphan-originals/gallery-listing-summary.md
# the private per-object gallery review file holds object names and listing/record ids: never commit it, wherever it is saved
gallery-listing-detail.csv
gallery-listing-summary.md
