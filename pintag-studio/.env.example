# Copy to .env.local and fill in real values. .env.local is git-ignored — never commit real credentials.
#
# This is also what lets "Start Marketing OS.command" launch with zero
# Terminal typing — see SETUP.md.

# Project Settings -> API
SUPABASE_URL=
# Project Settings -> API -> service_role (NOT anon — the pipeline needs this to bypass RLS)
SUPABASE_SERVICE_ROLE_KEY=

# Project Settings -> Database -> Connection string -> URI (used only for applying migrations)
SUPABASE_DB_URL=

# --- Deployed Founder Workspace only (SETUP.md §10) ---------------------------
# Leave ALL of these unset for local use: founder-server.ts then binds
# 127.0.0.1 with no auth, exactly as it always has.
#
# HOST=0.0.0.0 is what exposes the server. The moment it's non-loopback, the
# server REFUSES TO START unless MARKETING_OS_REQUIRE_AUTH=true and the three
# auth variables below are all set — most routes mutate state or spend LLM
# budget, so an open instance is not an acceptable default.
# HOST=0.0.0.0
# MARKETING_OS_REQUIRE_AUTH=true
# Project Settings -> API -> anon/public key. Used ONLY to verify the founder's
# own access token against Supabase Auth — never the service_role key for that.
# SUPABASE_ANON_KEY=
# The single account allowed in. Any other valid Supabase user is rejected.
# MARKETING_OS_FOUNDER_EMAIL=
# CORS allowlist for browser calls, comma-separated. Never "*": a wildcard plus
# bearer tokens would let any site you visit drive Marketing OS.
# MARKETING_OS_ALLOWED_ORIGINS=https://pintag.io

# See pipeline/lib/llm.ts — "claude-cli" (default) or "anthropic-api"
LLM_PROVIDER=claude-cli
# Only needed if LLM_PROVIDER=anthropic-api
ANTHROPIC_API_KEY=

# "simulate" (default, no real Meta credentials needed) or "live"
META_PUBLISH_MODE=simulate

# Optional — only needed once you've connected TikTok (SETUP.md "8. TikTok").
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# This exact value must also be registered as the Redirect URI in your
# TikTok Developer app (Login Kit, app type "Desktop"). Already correct —
# leave it as-is, it's not something you choose.
TIKTOK_REDIRECT_URI=http://127.0.0.1:4322/callback
